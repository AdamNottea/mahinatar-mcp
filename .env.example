# ── mahinatar-mcp configuration ──────────────────────────────────────────────
# Copy to .env (or set these in your Claude Code MCP config "env" block).

# Mahinatar's LIVE Supabase project (EZUG). Leave as-is.
MAHINATAR_SUPABASE_URL=https://ezugxjvjjqiccxocsojw.supabase.co

# The Supabase anon / publishable key (NOT the service-role key — never use that).
# Get it from Supabase dashboard → Project Settings → API → anon public.
MAHINATAR_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ── AUTH — pick ONE of the two methods below ─────────────────────────────────
#
# METHOD 1 (RECOMMENDED, esp. for Google-login users with NO password):
#   Connect with your own Supabase ACCESS TOKEN (a user JWT). The server attaches
#   it as a Bearer token, so every read/write is scoped to your account by RLS.
#   How to get it: log in to mahinatar.com, open DevTools → Console and run:
#     JSON.parse(localStorage.getItem(
#       Object.keys(localStorage).find(k => k.endsWith('-auth-token'))
#     )).access_token
#   (and likewise `.refresh_token` for the optional var below). Tokens expire;
#   if MAHINATAR_REFRESH_TOKEN is set the session can refresh itself.
MAHINATAR_ACCESS_TOKEN=
MAHINATAR_REFRESH_TOKEN=

# METHOD 2 (fallback): email + password. Only works if your account HAS a
# password (Google-login accounts usually don't — use METHOD 1). The server
# signs in as this user; every read/write is RLS-scoped to your account.
MAHINATAR_EMAIL=you@example.com
MAHINATAR_PASSWORD=your-mahinatar-password

# ── Live email send (all OPTIONAL — outreach is DRY-RUN by default) ──────────
# Resend API key. Live send is IMPOSSIBLE without this, regardless of the flag.
RESEND_API_KEY=

# Master safety switch. Must be the literal string "true" to allow real sends.
# Anything else (including unset) keeps every send tool in dry-run mode.
MAHINATAR_OUTREACH_LIVE=false

# Verified sender address on your warmed Resend domain. Used only for live send.
MAHINATAR_FROM_EMAIL=outreach@yourdomain.com
